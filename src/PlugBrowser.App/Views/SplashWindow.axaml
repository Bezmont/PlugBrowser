<!--
  Startup splash: the artwork alone, on a borderless, see-through window, so its own drop shadow is
  the only edge. Shown while the catalog loads and closed once the main window has drawn (App.axaml.cs).
  In the taskbar so the app is visibly starting, with the same icon the main window will have.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PlugBrowser.App.Views.SplashWindow"
        Title="PlugBrowser"
        Icon="/Assets/icon.ico"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">

  <Image Source="/Assets/splash.png" Width="536" Height="250"
         RenderOptions.BitmapInterpolationMode="HighQuality" />
</Window>
