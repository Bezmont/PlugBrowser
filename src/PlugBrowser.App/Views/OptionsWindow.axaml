<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlugBrowser.App.ViewModels"
        x:Class="PlugBrowser.App.Views.OptionsWindow"
        x:DataType="vm:OptionsViewModel"
        Title="Options — Scan Locations"
        Icon="/Assets/icon.ico"
        Width="760" Height="650"
        MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner">

  <DockPanel>

    <!-- Caption row (see Win11Chrome); no background, so all of it drags the window. -->
    <Panel DockPanel.Dock="Top" Height="32">
      <TextBlock Text="{Binding $parent[Window].Title}" Classes="caption" Margin="16,0" />
    </Panel>

  <DockPanel Margin="16,4,16,16">

    <!-- Dialog footer. Declared before the scan card so it docks beneath it: in a DockPanel the
         first child docked to an edge sits outermost. -->
    <Button DockPanel.Dock="Bottom" Content="Close" Click="OnCloseClick"
            HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="80" />

    <!-- Scan controls pinned to the bottom so they stay put as the root list grows -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1"
            CornerRadius="6" Padding="14" Margin="0,14,0,0">
      <StackPanel Spacing="10">

        <!-- Wraps rather than clipping when the dialog is narrowed; the right margin stands in for
             Spacing, which WrapPanel does not have in this Avalonia version. -->
        <WrapPanel>
          <WrapPanel.Styles>
            <Style Selector="CheckBox">
              <Setter Property="Margin" Value="0,0,18,0" />
            </Style>
          </WrapPanel.Styles>
          <CheckBox Content="Load plugins for details and screenshots"
                    IsChecked="{Binding CaptureScreenshots}"
                    IsEnabled="{Binding !IsScanning}"
                    ToolTip.Tip="Off means a fast, completely safe scan that reads file metadata only." />
          <CheckBox Content="Re-scan unchanged plugins"
                    IsChecked="{Binding ForceRescan}"
                    IsEnabled="{Binding !IsScanning}"
                    ToolTip.Tip="Normally plugins that have not changed since the last scan are skipped." />
          <CheckBox Content="Skip failed plugins"
                    IsChecked="{Binding SkipFailed}"
                    IsEnabled="{Binding !IsScanning}"
                    ToolTip.Tip="Don't retry plugins that failed or timed out last time. A plugin that has been updated since is still retried. Reload &amp; recapture in the main window always retries." />
        </WrapPanel>

        <TextBlock Text="Loading plugins runs each one in a separate, sandboxed process. Some plugins take several seconds, and a few may never respond — those are given up on and listed as failures."
                   Classes="label" TextWrapping="Wrap" />

        <ProgressBar Value="{Binding Progress}" Maximum="100"
                     IsIndeterminate="{Binding IsIndeterminate}"
                     IsVisible="{Binding IsScanning}" Height="6" />

        <TextBlock Text="{Binding CurrentItem}" Classes="label"
                   TextTrimming="CharacterEllipsis" MaxLines="1"
                   IsVisible="{Binding IsScanning}" />

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center"
                     FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0" />

          <Button Grid.Column="1" Content="Scan now" Command="{Binding ScanCommand}"
                  IsVisible="{Binding !IsScanning}" Classes="accent" MinWidth="110" />
          <Button Grid.Column="1" Content="Cancel scan" Command="{Binding CancelScanCommand}"
                  IsVisible="{Binding IsScanning}" MinWidth="110" />
        </Grid>

        <Border Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="10"
                IsVisible="{Binding HasSummary}">
          <StackPanel>
            <TextBlock Text="LAST SCAN" Classes="section" />
            <TextBlock Text="{Binding LastSummary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="DUPLICATES ACROSS FORMATS" Classes="section" />
              <TextBlock Text="{Binding DuplicateSummary}" FontSize="12" TextWrapping="Wrap"
                         Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Review duplicates…" Click="OnDuplicatesClick"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- Header -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="Scan locations" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="Folders PlugBrowser searches for plugins. Standard and installer-registered locations are detected automatically; you can switch any of them off or add your own."
                 Classes="label" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="{Binding EnabledSummary}" Classes="label"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Add folder…" Click="OnAddFolderClick"
              IsEnabled="{Binding !IsScanning}" />
    </Grid>

    <Border Background="{DynamicResource InsetBrush}" CornerRadius="6"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
      <ListBox ItemsSource="{Binding Roots}" Background="Transparent" Padding="4">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScanRootViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4">
              <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                        Margin="0,0,8,0" />

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis"
                           MaxLines="1" Opacity="{Binding PathOpacity}" />
                <TextBlock Text="{Binding OriginLabel}" Classes="label" />
              </StackPanel>

              <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Classes="label"
                         VerticalAlignment="Center" Margin="12,0" />

              <Button Grid.Column="3" Content="Remove" VerticalAlignment="Center"
                      IsVisible="{Binding CanRemove}"
                      Command="{Binding $parent[Window].((vm:OptionsViewModel)DataContext).RemoveRootCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

  </DockPanel>
  </DockPanel>
</Window>
